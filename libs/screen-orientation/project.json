{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "screen-orientation",
    "projectType": "library",
    "sourceRoot": "libs/screen-orientation",
    "targets": {
        "build": {
            "dependsOn": [
                {
                    "dependencies": true,
                    "params": "forward",
                    "target": "build"
                }
            ],
            "executor": "nx:run-commands",
            "options": {
                "commands": ["ng-packagr -p libs/{projectName}/ng-package.json -c tsconfig.build.json", "node tools/copy-license.mjs {projectName}"],
                "parallel": false
            },
            "outputs": ["{workspaceRoot}/dist/{projectName}"]
        },
        "publish": {
            "dependsOn": [
                {
                    "dependencies": false,
                    "params": "ignore",
                    "target": "build"
                }
            ],
            "executor": "nx:run-commands",
            "options": {
                "command": "npm publish ./dist/{projectName} --ignore-scripts"
            }
        }
    }
}
