{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "workers",
    "projectType": "library",
    "sourceRoot": "libs/workers",
    "targets": {
        "build": {
            "dependsOn": [
                {
                    "dependencies": true,
                    "params": "forward",
                    "target": "build"
                }
            ],
            "executor": "nx:run-commands",
            "options": {
                "commands": ["ng-packagr -p libs/{projectName}/ng-package.json -c tsconfig.build.json", "node tools/copy-license.mjs {projectName}"],
                "parallel": false
            },
            "outputs": ["{workspaceRoot}/dist/workers"]
        },
        "publish": {
            "dependsOn": [
                {
                    "dependencies": false,
                    "params": "ignore",
                    "target": "build"
                }
            ],
            "executor": "nx:run-commands",
            "options": {
                "command": "npm publish ./dist/{projectName} --ignore-scripts"
            }
        },
        "test": {
            "executor": "@angular-devkit/build-angular:karma",
            "options": {
                "browsers": "ChromeHeadless",
                "codeCoverage": true,
                "karmaConfig": "libs/workers/karma.conf.js",
                "main": "libs/workers/test.ts",
                "tsConfig": "tsconfig.spec.json"
            },
            "outputs": ["{workspaceRoot}/coverage/workers"]
        }
    }
}
